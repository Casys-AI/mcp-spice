{
  "name": "@casys/mcp-spice",
  "version": "0.1.0",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@casys/mcp-server"]
  },
  "tasks": {
    "serve": "deno run --allow-all server.ts --port=3023",
    "check": "deno check mod.ts server.ts src/client.ts src/api/ngspice.ts src/api/netlist-artifact.ts src/tools/types.ts src/tools/mod.ts src/tools/op.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check deno.json mod.ts server.ts src tests",
    "release:check": "deno task fmt && deno task check && deno task lint && deno task test",
    "test": "deno test --allow-all tests/"
  },
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "server.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@0.24.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1.1.0"
  },
  "fmt": {
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "include": ["no-unused-vars", "no-explicit-any"]
    }
  }
}
